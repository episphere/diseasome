{
  "name": "polygenic-risk-scores",
  "version": "0.2.0",
  "description": "Utilities for fetching/parsing PGS Catalog scores and 23andMe data for PRS workflows.",
  "type": "module",
  "main": "./dist/sdk.mjs",
  "module": "./dist/sdk.mjs",
  "exports": {
    ".": "./dist/sdk.mjs",
    "./cloud_sdk.mjs": "./dist/cloud_sdk.mjs"
  },
  "files": [
    "dist/sdk.mjs",
    "dist/sdk.mjs.map",
    "dist/cloud_sdk.mjs",
    "dist/cloud_sdk.mjs.map",
    "README.md"
  ],
  "keywords": [
    "pgs",
    "prs",
    "genomics",
    "23andme",
    "polygenic-risk-score"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@xenova/transformers": "^2.17.0",
    "clustjs": "github:lorenasandoval88/clustjs",
    "d3-svg-to-png": "^0.3.2",
    "localforage": "^1.10.0",
    "personal_genomes_project_sdk": "github:lorenasandoval88/personal_genomes_project_sdk",
    "pgs_catalog_sdk": "github:lorenasandoval88/pgs_catalog_sdk",
    "rollup": "^4.34.9"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist/chunks',{recursive:true,force:true})\"",
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run"
  }
